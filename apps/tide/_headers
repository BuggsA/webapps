# Cloudflare response headers for apps/tide (served by the Worker in
# cloudflare/tide). Format: https://developers.cloudflare.com/workers/static-assets/headers/

# Everything: no MIME sniffing, no Referer sent to the APIs the page calls.
# Geolocation is deliberately NOT blocked - "Use my location" needs it.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), interest-cohort=()

# The font files never change under the same name. If a font is ever
# replaced, give the file a new name rather than shortening this.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# The tide field, coastlines and station index: rebuilt rarely, and the
# page fetches them by fixed names. A day fresh, then a week of serving the
# cached copy while a newer one is fetched in the background.
/data/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
