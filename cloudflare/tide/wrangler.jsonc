// Tide on Cloudflare: a Worker with static assets and no script (owner,
// 2026-11-12: "I'd prefer to use a worker"). Tide is pure static - every
// network call it makes goes from the browser straight to Open-Meteo, NOAA
// or BigDataCloud - so the Worker only serves files. Static asset requests
// are free and do not count against the Workers request quota.
//
// The assets are served straight out of apps/tide (no copy step): the
// directory is resolved relative to this file. apps/tide/.assetsignore keeps
// the README off the site; apps/tide/_headers sets the response headers.
//
// Workers Builds settings (dashboard): root directory `cloudflare/tide`,
// build command empty, deploy command `npx wrangler deploy`.
{
  "$schema": "https://unpkg.com/wrangler@4.160.1/config-schema.json",
  "name": "tide",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "../../apps/tide",
    // Unknown paths answer apps/tide/404.html with a 404 status - never
    // index.html with a 200, which search engines read as duplicate pages.
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // Served only at https://tidehere.app/ (owner, 2026-11-12: "turn off
  // workers.dev too") so the same site is not indexed at two addresses.
  // Preview URLs live on workers.dev, so branch previews go with it: check a
  // branch locally with `npx wrangler dev` before merging.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
